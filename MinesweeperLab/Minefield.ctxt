comment2.target=Minefield()
comment2.text=\n\ Creates\ a\ default\ 9\ by\ 9\ mine\ field.\n
comment3.params=
comment3.target=int\ numRows()
comment3.text=\n\ Returns\ the\ number\ of\ rows\ in\ this\ minefield.\ \n\ \n\ @return\ \ row\ count\ \n
comment4.params=
comment4.target=int\ numCols()
